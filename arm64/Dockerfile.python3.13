FROM scratch

ADD 3281bc8cb94538c390dbc81f89ecfabf0263a2df390306b97439795647943a2f.tar.xz /
ADD 63af5f42c03f2dc3f8511829f4924f8771e0495b42524699d06fa67503064ef3.tar.xz /
ADD 8a076f3c2fd44ca3f13e54642934a89a2d9521943f8d104b83d931d94bbda2a7.tar.xz /
ADD a66735c42f1c442ae5172d2ce828909daa511ba0f5538220f84b5918193f4e2e.tar.xz /
ADD ae6776cc842b1a8890e718a579cd309e2e58d2264b4ff32dbf6935399f4a347a.tar.xz /
ADD d5f2eff51f21753859198355c431e466981790d679b78d291d2f2913adfceff8.tar.xz /

ENV LANG=en_US.UTF-8
